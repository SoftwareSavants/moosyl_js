{
  "name": "moosyl-sdk",
  "version": "1.2.0",
  "description": "integrating payment solutions with Mauritania's popular banking apps",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "react-native": "dist/client.js",
  "exports": {
    ".": {
      "react-native": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      },
      "workerd": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "worker": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "edge-light": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "browser": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test \"test/**/*.test.mjs\"",
    "smoke": "npm run build && node scripts/smoke-gimtel.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SoftwareSavants/moosyl_js.git"
  },
  "keywords": [
    "moosyl",
    "bankily",
    "sedad",
    "masrivi",
    "amanty",
    "bci_pay",
    "bim_bank",
    "api"
  ],
  "author": "software-savants",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/SoftwareSavants/moosyl_js/issues"
  },
  "homepage": "https://github.com/SoftwareSavants/moosyl_js#readme",
  "files": [
    "dist",
    "client",
    "README.md",
    "CHANGELOG.md"
  ]
}
